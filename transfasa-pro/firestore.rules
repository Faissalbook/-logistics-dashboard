rules_version = '2';

// TransFasa Pro — Firestore security rules.
// Mirrors packages/domain/src/rbac.ts (PRD §9.1). Default deny (SEC-04).
// Every write that touches money, status, users or the audit log goes through
// Cloud Functions (Admin SDK bypasses these rules), so client writes are denied here
// unless a later phase explicitly opens a path.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roles() {
      return signedIn() && request.auth.token.roles is list ? request.auth.token.roles : [];
    }

    function hasAnyRole(rs) {
      return roles().hasAny(rs);
    }

    function hasSomeRole() {
      return roles().size() > 0;
    }

    // users: own profile, or OWNER (user.read)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasAnyRole(['OWNER']));
      allow write: if false;
    }

    // audit_log: OWNER, ACCOUNTANT (audit.read). Append-only via functions; never client-writable.
    match /audit_log/{entry} {
      allow read: if hasAnyRole(['OWNER', 'ACCOUNTANT']);
      allow write: if false;
    }

    // system: chain head & verification status — OWNER read only.
    match /system/{doc} {
      allow read: if hasAnyRole(['OWNER']);
      allow write: if false;
    }

    // settings: any user with a role (settings.read); writes via functions (settings.write = OWNER).
    match /settings/{key} {
      allow read: if hasSomeRole();
      allow write: if false;
    }

    // ---------------------------------------------------------------- Phase 1 — operations
    // Role lists mirror the 'all'-scope grants in rbac.ts; tests/integration/rules.test.ts
    // checks every path × every role against that matrix.

    function vehicleReadAll() {
      return hasAnyRole(['OWNER', 'PROCUREMENT', 'CUSTOMS', 'FLEET_MANAGER', 'ACCOUNTANT', 'VIEWER']);
    }
    function tripReadAll() {
      return hasAnyRole(['OWNER', 'FLEET_MANAGER', 'ACCOUNTANT', 'VIEWER']);
    }
    function expenseReadAll() {
      return hasAnyRole(['OWNER', 'FLEET_MANAGER', 'ACCOUNTANT', 'VIEWER']);
    }
    function isDriver() {
      return hasAnyRole(['DRIVER']);
    }

    // vehicles: vehicle.read (all) or the driver currently assigned to it (own)
    match /vehicles/{id} {
      allow read: if vehicleReadAll()
        || (isDriver() && resource.data.currentDriverUserId == request.auth.uid);
      allow write: if false;
    }

    match /vehicle_assignments/{id} {
      allow read: if vehicleReadAll();
      allow write: if false;
    }

    // drivers hold personal data: readers of all trips, or the driver's own record
    match /drivers/{id} {
      allow read: if tripReadAll()
        || (isDriver() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // reference data: refData.read (every role)
    match /destinations/{id} {
      allow read: if hasSomeRole();
      allow write: if false;
    }
    match /cement_types/{id} {
      allow read: if hasSomeRole();
      allow write: if false;
    }
    match /rate_cards/{id} {
      allow read: if hasSomeRole();
      allow write: if false;
    }

    // trips: trip.read (all), drivers only their own (driverUserId)
    match /trips/{id} {
      allow read: if tripReadAll()
        || (isDriver() && resource.data.driverUserId == request.auth.uid);
      allow write: if false;
    }

    // expenses: expense.read (all), drivers only what they entered
    match /expenses/{id} {
      allow read: if expenseReadAll()
        || (isDriver() && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
